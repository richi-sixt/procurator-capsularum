{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Procurator Capsularum",
  "version": "0.1.0",
  "identifier": "io.github.richi-sixt.procurator-capsularum",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Procurator Capsularum",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/dist/pc-server": "pc-server"
    },
    "category": "Utility",
    "copyright": "© 2026 Rüchan Sixt",
    "license": "AGPL-3.0-or-later",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
